programa {
  funcao inicio() {
      cadeia lista_supermercado[5]
      para(inteiro i = 0; i<5; i++){
      escreva("Digite os itens que você pegou:")
      leia(lista_supermercado[i])  
      }

      para(inteiro i = 0; i<5; i++){
       escreva("\n", lista_supermercado[i]) 
      }
       
      



  }
}
